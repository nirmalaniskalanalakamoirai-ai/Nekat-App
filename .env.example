# =============================================================================
# NEKAT — daftar environment variable (ADR-0001 §6)
#
# File ini HANYA berisi NAMA variabel + keterangan. JANGAN isi nilai rahasia di sini.
# Salin ke `.env` untuk dev lokal (`.env*` selain file ini diabaikan git).
# Staging/production: nilai diambil dari secret store (GitHub Actions secrets /
# secret manager host), bukan dari file.
#
# Tanda [dipakai] = sudah dibaca kode di T-012. Lainnya dicadangkan untuk task berikutnya.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Server SELALU UTC; konversi ke WIB hanya di tepi (ADR §3.3 prinsip 4).
TZ=UTC

# --- API (apps/api) ----------------------------------------------------------
# [dipakai] Alamat & port HTTP API. Default 0.0.0.0:3000.
HOST=0.0.0.0
PORT=3000
# Base URL publik (domain menunggu keputusan #6). Contoh dev: http://localhost:3000
APP_BASE_URL=

# --- Database (PostgreSQL) ---------------------------------------------------
# [dipakai oleh apps/worker] Format: postgres://PENGGUNA:PASSWORD@HOST:5432/NAMA_DB
# Rahasia di staging/production. Skema & migrasi dibuat di T-013.
DATABASE_URL=

# --- Inventory (ADR §4.1) ----------------------------------------------------
# local | gudang. Dibaca saat start, divalidasi (T-018).
INVENTORY_SOURCE=local
# Hanya bila INVENTORY_SOURCE=gudang (T-019). Token = rahasia.
GUDANG_API_URL=
GUDANG_API_TOKEN=

# --- Xendit (ADR §4.2, T-029) ------------------------------------------------
# Rahasia. Kunci MODE TEST di dev/staging; kunci live hanya di production.
XENDIT_SECRET_KEY=
# Rahasia. Token verifikasi header `x-callback-token` webhook (dibandingkan constant-time).
XENDIT_CALLBACK_TOKEN=

# --- WhatsApp (ADR §4.3, T-016) ----------------------------------------------
# log | sandbox | (mode produksi menunggu H2). Penjaga start menolak `log` di production.
WA_MODE=log
# Kredensial gateway produksi/sandbox ditambahkan setelah H2 diputuskan.

# --- Log ---------------------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
