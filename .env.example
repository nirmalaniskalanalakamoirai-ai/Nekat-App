# =============================================================================
# NEKAT — daftar environment variable (ADR-0001 §6)
#
# File ini HANYA berisi NAMA variabel + keterangan. JANGAN isi nilai rahasia di sini.
# Salin ke `.env` untuk dev lokal (`.env*` selain file ini diabaikan git).
# Staging/production: nilai diambil dari secret store (GitHub Actions secrets /
# secret manager host), bukan dari file.
#
# Tanda [dipakai] = sudah dibaca kode di T-012. Lainnya dicadangkan untuk task berikutnya.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Server SELALU UTC; konversi ke WIB hanya di tepi (ADR §3.3 prinsip 4).
TZ=UTC

# --- API (apps/api) ----------------------------------------------------------
# [dipakai] Alamat & port HTTP API. Default 0.0.0.0:3000.
HOST=0.0.0.0
PORT=3000
# Base URL publik (domain menunggu keputusan #6). Contoh dev: http://localhost:3000
APP_BASE_URL=

# --- Database (PostgreSQL) ---------------------------------------------------
# [dipakai oleh apps/worker & apps/api] Format: postgres://PENGGUNA:PASSWORD@HOST:5432/NAMA_DB
# API: kosong = rute katalog menjawab 503 (T-025).
# Rahasia di staging/production. Skema & migrasi dibuat di T-013.
DATABASE_URL=

# --- Katalog (T-025) ---------------------------------------------------------
# [dipakai] Umur cache snapshot katalog di API (detik), 0–300; 0 = tanpa cache. Default 10.
KATALOG_CACHE_DETIK=10

# --- Panel admin (T-036, H9) ------------------------------------------------
# [dipakai] Panel /api/admin aktif bila DATABASE_URL + kedua kunci di bawah diisi; keduanya kosong
# = panel menjawab 503. Hanya salah satu diisi / format salah → API gagal start (nama variabel saja).
# Rahasia. Kunci AES-256-GCM rahasia TOTP admin: TEPAT 32 byte, base64.
#   Buat: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_TOTP_KUNCI=
# [dipakai] Versi kunci di atas (disimpan per admin untuk rotasi kunci). Default 1.
ADMIN_TOTP_KUNCI_VERSI=1
# Rahasia. Kunci HMAC token CSRF & ip_hmac log: minimal 32 byte, base64. Beda dari kunci TOTP.
ADMIN_HMAC_KUNCI=
# [dipakai] Umur absolut sesi admin dalam menit, 5–720 (lebih pendek dari sesi pembeli). Default 240.
ADMIN_SESI_MENIT=240
# [dipakai] Jumlah reverse proxy tepercaya di depan API (IP klien untuk batas laju & log), 0–5. Default 0.
TRUST_PROXY=0
# Catatan: APP_BASE_URL (di atas) juga dipakai sebagai satu-satunya Origin yang boleh memanggil API admin.
# Admin pertama dibuat lewat CLI (bukan endpoint): pnpm --filter @nekat/api admin:buat -- --nama "..." --hp +628... --peran owner

# --- Inventory (ADR §4.1) ----------------------------------------------------
# [dipakai] local | gudang. Dibaca saat start oleh API & worker; nilai lain → gagal start (T-018).
# `gudang` belum diimplementasi (T-019): API & worker menolak start dengan pesan "belum diimplementasi".
INVENTORY_SOURCE=local
# [dipakai] Batas usia data snapshot dalam menit, 1–1440 (P-10, diputuskan: 15).
INVENTORY_MAKS_UMUR_DATA_MENIT=15
# [dipakai] tahan_checkout | jual_snapshot. Perilaku saat sumber stok tak terjangkau (H14, diputuskan: tahan_checkout).
INVENTORY_SAAT_GANGGUAN=tahan_checkout
# [dipakai] Interval job sinkron inventori dalam menit, 1–1440 (job dibuat di T-019).
INVENTORY_INTERVAL_SINKRON_MENIT=5
# Hanya bila INVENTORY_SOURCE=gudang (T-019). Token = rahasia.
GUDANG_API_URL=
GUDANG_API_TOKEN=

# --- Xendit (ADR §4.2, T-029) ------------------------------------------------
# Rahasia. Kunci MODE TEST di dev/staging; kunci live hanya di production.
XENDIT_SECRET_KEY=
# Rahasia. Token verifikasi header `x-callback-token` webhook (dibandingkan constant-time).
XENDIT_CALLBACK_TOKEN=

# --- WhatsApp (ADR §4.3, T-016) ----------------------------------------------
# log | sandbox | (mode produksi menunggu H2). Penjaga start menolak `log` di production.
WA_MODE=log
# Kredensial gateway produksi/sandbox ditambahkan setelah H2 diputuskan.

# --- Log ---------------------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
