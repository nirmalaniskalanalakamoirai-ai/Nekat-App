# =============================================================================
# NEKAT — daftar environment variable (ADR-0001 §6)
#
# File ini HANYA berisi NAMA variabel + keterangan. JANGAN isi nilai rahasia di sini.
# Salin ke `.env` untuk dev lokal (`.env*` selain file ini diabaikan git).
# Staging/production: nilai diambil dari secret store (GitHub Actions secrets /
# secret manager host), bukan dari file.
#
# Tanda [dipakai] = sudah dibaca kode di T-012. Lainnya dicadangkan untuk task berikutnya.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Server SELALU UTC; konversi ke WIB hanya di tepi (ADR §3.3 prinsip 4).
TZ=UTC

# --- API (apps/api) ----------------------------------------------------------
# [dipakai] Alamat & port HTTP API. Default 0.0.0.0:3000.
HOST=0.0.0.0
PORT=3000
# Base URL publik (domain menunggu keputusan #6). Contoh dev: http://localhost:3000
APP_BASE_URL=

# --- Database (PostgreSQL) ---------------------------------------------------
# [dipakai oleh apps/worker & apps/api] Format: postgres://PENGGUNA:PASSWORD@HOST:5432/NAMA_DB
# API: kosong = rute katalog menjawab 503 (T-025).
# Rahasia di staging/production. Skema & migrasi dibuat di T-013.
DATABASE_URL=

# --- Katalog (T-025) ---------------------------------------------------------
# [dipakai] Umur cache snapshot katalog di API (detik), 0–300; 0 = tanpa cache. Default 10.
KATALOG_CACHE_DETIK=10

# --- Panel admin (T-036, H9) ------------------------------------------------
# [dipakai] Panel /api/admin aktif bila DATABASE_URL + kedua kunci di bawah diisi; keduanya kosong
# = panel menjawab 503. Hanya salah satu diisi / format salah → API gagal start (nama variabel saja).
# Rahasia. Kunci AES-256-GCM rahasia TOTP admin: TEPAT 32 byte, base64.
#   Buat: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_TOTP_KUNCI=
# [dipakai] Versi kunci di atas (disimpan per admin untuk rotasi kunci). Default 1.
ADMIN_TOTP_KUNCI_VERSI=1
# Rahasia. Kunci HMAC (pepper) token CSRF, ip_hmac log, dan hash kode pemulihan TOTP: minimal
# 32 byte, base64, WAJIB beda dari ADMIN_TOTP_KUNCI (sama → gagal start). Mengganti kunci ini
# membatalkan semua kode pemulihan & sesi admin.
ADMIN_HMAC_KUNCI=
# [dipakai] Umur absolut sesi admin dalam menit, 5–720 (lebih pendek dari sesi pembeli). Default 240.
ADMIN_SESI_MENIT=240
# [dipakai] Sesi admin berakhir bila tidak ada permintaan selama ini (menit), 5–240. Default 30.
ADMIN_SESI_IDLE_MENIT=30
# [dipakai] Rem darurat: batas percobaan masuk admin per menit untuk SEMUA IP, 0 = mati. Default 600.
# Beban scrypt sudah dibatasi semafor (maks 2 bersamaan → 503 bila penuh), jadi nilai ini sengaja
# tinggi: nilai kecil memudahkan penyerang mengunci semua admin dari login.
ADMIN_MASUK_GLOBAL_PER_MENIT=600
# [dipakai] Alamat/CIDR reverse proxy TEPERCAYA, pisah koma (mis. 127.0.0.1 atau 10.0.0.0/8).
# X-Forwarded-For hanya dipercaya dari alamat ini (IP klien untuk batas laju & ip_hmac). Kosong =
# XFF diabaikan. Jumlah hop / "true" DITOLAK. Bila diisi, API WAJIB tidak bisa dihubungi langsung
# dari luar: HOST=127.0.0.1 (proxy di mesin yang sama) atau firewall hanya izinkan proxy.
TRUST_PROXY=
# Catatan:
# - APP_BASE_URL (di atas) juga dipakai sebagai satu-satunya Origin yang boleh memanggil API admin.
# - Reverse proxy: halaman /admin (index.html) dilayani dengan header
#   `Content-Security-Policy: frame-ancestors 'none'`, `X-Frame-Options: DENY`, HSTS, dan
#   `Cache-Control: no-store` (respons /api/admin sudah mengirim header ini sendiri).
# - Admin dibuat lewat CLI di server (bukan endpoint); nama & nomor HP ditanyakan interaktif:
#     pnpm --filter @nekat/api admin:buat --peran owner
#   Lepas penguncian akun (break-glass, tercatat di log_audit):
#     pnpm --filter @nekat/api admin:buka-kunci

# --- Inventory (ADR §4.1) ----------------------------------------------------
# [dipakai] local | gudang. Dibaca saat start oleh API & worker; nilai lain → gagal start (T-018).
# `gudang` (T-019): worker menyinkron SKU/stok/modal dari API Gudang ke snapshot lokal dan mengirim
# permintaan picking; API katalog SELALU membaca snapshot lokal (tidak memanggil Gudang per request).
INVENTORY_SOURCE=local
# [dipakai] Batas usia data snapshot dalam menit, 1–1440 (P-10, diputuskan: 15).
INVENTORY_MAKS_UMUR_DATA_MENIT=15
# [dipakai] tahan_checkout | jual_snapshot. Perilaku saat sumber stok tak terjangkau (H14, diputuskan: tahan_checkout).
INVENTORY_SAAT_GANGGUAN=tahan_checkout
# [dipakai] Interval job sinkron Gudang (worker) dalam menit, 1–1440 (T-019).
INVENTORY_INTERVAL_SINKRON_MENIT=5
# [dipakai] Ambang anomali sinkron penuh Gudang (T-019, default sementara IG-08): bila SKU yang akan
# dinonaktifkan karena hilang dari daftar Gudang > N SKU ATAU > X % SKU terpetakan → penonaktifan
# ditahan + log audit. Default 50 SKU / 20 %.
INVENTORY_BATAS_NONAKTIF_SKU=50
INVENTORY_BATAS_NONAKTIF_PERSEN=20
# [dipakai] Wajib bila INVENTORY_SOURCE=gudang (T-019). URL wajib https:// tanpa user:password
# (validasi saat start), contoh bentuk: https://gudang.contoh.id/api — JANGAN isi nilai di file ini.
GUDANG_API_URL=
# [dipakai] Rahasia (secret store saja). Dikirim hanya sebagai header Authorization: Bearer, tidak pernah di URL/log.
GUDANG_API_TOKEN=

# --- Pembayaran / Xendit (ADR §4.2, T-029) -----------------------------------
# [dipakai] nonaktif | palsu | xendit. Kosong = nonaktif (POST /api/tagihan/:id/bayar menjawab 503).
# `palsu` = GatewayPalsu di memori untuk dev (QR/VA palsu, tidak bisa dibayar); DITOLAK di production.
PEMBAYARAN_GATEWAY=
# [dipakai] Wajib bila gateway aktif. Nama badan usaha NEKAT (H7) yang tampil sebagai pemilik VA &
# penerima; BUKAN nama pembeli/host (docs/flow/pembayaran.md §5.3). 3–64 karakter.
PEMBAYARAN_NAMA_MERCHANT=
# [dipakai] Kode bank VA yang ditawarkan, pisah koma (harus aktif di akun Xendit). Default: BNI,BRI,MANDIRI,PERMATA.
XENDIT_KANAL_VA=
# [dipakai] Rahasia. Pagar start-up (FP-02): NODE_ENV=production WAJIB kunci live (xnd_production_…),
# selain production WAJIB kunci test (xnd_development_…). Salah mode → API gagal start (hanya nama variabel
# yang dicetak). Dikirim hanya di header Authorization (Basic), tidak pernah di URL/log.
XENDIT_SECRET_KEY=
# Rahasia. Token verifikasi header `x-callback-token` webhook (dibandingkan constant-time).
XENDIT_CALLBACK_TOKEN=

# --- WhatsApp (ADR §4.3, T-016) ----------------------------------------------
# log | sandbox | (mode produksi menunggu H2). Penjaga start menolak `log` di production.
WA_MODE=log
# Kredensial gateway produksi/sandbox ditambahkan setelah H2 diputuskan.

# --- Log ---------------------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
