# =============================================================================
# NEKAT — daftar environment variable (ADR-0001 §6)
#
# File ini HANYA berisi NAMA variabel + keterangan. JANGAN isi nilai rahasia di sini.
# Salin ke `.env` untuk dev lokal (`.env*` selain file ini diabaikan git).
# Staging/production: nilai diambil dari secret store (GitHub Actions secrets /
# secret manager host), bukan dari file.
#
# Tanda [dipakai] = sudah dibaca kode di T-012. Lainnya dicadangkan untuk task berikutnya.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# [dipakai] WAJIB salah satu: development | test | staging | production. Kosong / nilai lain → API
# gagal start (pagar mode WhatsApp & pembayaran tidak boleh "gagal terbuka", T-016).
NODE_ENV=development
# Server SELALU UTC; konversi ke WIB hanya di tepi (ADR §3.3 prinsip 4).
TZ=UTC

# --- API (apps/api) ----------------------------------------------------------
# [dipakai] Alamat & port HTTP API. Default 0.0.0.0:3000.
HOST=0.0.0.0
PORT=3000
# Base URL publik (domain menunggu keputusan #6). Juga satu-satunya Origin yang boleh memanggil API
# admin & login pembeli. Dev dengan Vite: http://localhost:5173 (Origin halaman, bukan port API).
APP_BASE_URL=

# --- Database (PostgreSQL) ---------------------------------------------------
# [dipakai oleh apps/worker & apps/api] Format: postgres://PENGGUNA:PASSWORD@HOST:5432/NAMA_DB
# API: kosong = rute katalog menjawab 503 (T-025).
# Rahasia di staging/production. Skema & migrasi dibuat di T-013.
DATABASE_URL=

# --- Katalog (T-025) ---------------------------------------------------------
# [dipakai] Umur cache snapshot katalog di API (detik), 0–300; 0 = tanpa cache. Default 10.
KATALOG_CACHE_DETIK=10

# --- Panel admin (T-036, H9) ------------------------------------------------
# [dipakai] Panel /api/admin aktif bila DATABASE_URL + kedua kunci di bawah diisi; keduanya kosong
# = panel menjawab 503. Hanya salah satu diisi / format salah → API gagal start (nama variabel saja).
# Rahasia. Kunci AES-256-GCM rahasia TOTP admin: TEPAT 32 byte, base64.
#   Buat: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_TOTP_KUNCI=
# [dipakai] Versi kunci di atas (disimpan per admin untuk rotasi kunci). Default 1.
ADMIN_TOTP_KUNCI_VERSI=1
# Rahasia. Kunci HMAC (pepper) token CSRF, ip_hmac log, dan hash kode pemulihan TOTP: minimal
# 32 byte, base64, WAJIB beda dari ADMIN_TOTP_KUNCI (sama → gagal start). Mengganti kunci ini
# membatalkan semua kode pemulihan & sesi admin.
ADMIN_HMAC_KUNCI=
# [dipakai] Umur absolut sesi admin dalam menit, 5–720 (lebih pendek dari sesi pembeli). Default 240.
ADMIN_SESI_MENIT=240
# [dipakai] Sesi admin berakhir bila tidak ada permintaan selama ini (menit), 5–240. Default 30.
ADMIN_SESI_IDLE_MENIT=30
# [dipakai] Rem darurat: batas percobaan masuk admin per menit untuk SEMUA IP, 0 = mati. Default 600.
# Beban scrypt sudah dibatasi semafor (maks 2 bersamaan → 503 bila penuh), jadi nilai ini sengaja
# tinggi: nilai kecil memudahkan penyerang mengunci semua admin dari login.
ADMIN_MASUK_GLOBAL_PER_MENIT=600
# [dipakai] Alamat/CIDR reverse proxy TEPERCAYA, pisah koma (mis. 127.0.0.1 atau 10.0.0.0/8).
# X-Forwarded-For hanya dipercaya dari alamat ini (IP klien untuk batas laju & ip_hmac). Kosong =
# XFF diabaikan. Jumlah hop / "true" DITOLAK. Bila diisi, API WAJIB tidak bisa dihubungi langsung
# dari luar: HOST=127.0.0.1 (proxy di mesin yang sama) atau firewall hanya izinkan proxy.
TRUST_PROXY=
# Catatan:
# - APP_BASE_URL (di atas) juga dipakai sebagai satu-satunya Origin yang boleh memanggil API admin.
# - Reverse proxy: halaman /admin (index.html) dilayani dengan header
#   `Content-Security-Policy: frame-ancestors 'none'`, `X-Frame-Options: DENY`, HSTS, dan
#   `Cache-Control: no-store` (respons /api/admin sudah mengirim header ini sendiri).
# - Admin dibuat lewat CLI di server (bukan endpoint); nama & nomor HP ditanyakan interaktif:
#     pnpm --filter @nekat/api admin:buat --peran owner
#   Lepas penguncian akun (break-glass, tercatat di log_audit):
#     pnpm --filter @nekat/api admin:buka-kunci

# --- Inventory (ADR §4.1) ----------------------------------------------------
# [dipakai] local | gudang. Dibaca saat start oleh API & worker; nilai lain → gagal start (T-018).
# `gudang` (T-019): worker menyinkron SKU/stok/modal dari API Gudang ke snapshot lokal dan mengirim
# permintaan picking; API katalog SELALU membaca snapshot lokal (tidak memanggil Gudang per request).
INVENTORY_SOURCE=local
# [dipakai] Batas usia data snapshot dalam menit, 1–1440 (P-10, diputuskan: 15).
INVENTORY_MAKS_UMUR_DATA_MENIT=15
# [dipakai] tahan_checkout | jual_snapshot. Perilaku saat sumber stok tak terjangkau (H14, diputuskan: tahan_checkout).
INVENTORY_SAAT_GANGGUAN=tahan_checkout
# [dipakai] Interval job sinkron Gudang (worker) dalam menit, 1–1440 (T-019).
INVENTORY_INTERVAL_SINKRON_MENIT=5
# [dipakai] Ambang anomali sinkron penuh Gudang (T-019, default sementara IG-08): bila SKU yang akan
# dinonaktifkan karena hilang dari daftar Gudang > N SKU ATAU > X % SKU terpetakan → penonaktifan
# ditahan + log audit. Default 50 SKU / 20 %.
INVENTORY_BATAS_NONAKTIF_SKU=50
INVENTORY_BATAS_NONAKTIF_PERSEN=20
# [dipakai] Wajib bila INVENTORY_SOURCE=gudang (T-019). URL wajib https:// tanpa user:password
# (validasi saat start), contoh bentuk: https://gudang.contoh.id/api — JANGAN isi nilai di file ini.
GUDANG_API_URL=
# [dipakai] Rahasia (secret store saja). Dikirim hanya sebagai header Authorization: Bearer, tidak pernah di URL/log.
GUDANG_API_TOKEN=

# --- Xendit (ADR §4.2, T-029) ------------------------------------------------
# Rahasia. Kunci MODE TEST di dev/staging; kunci live hanya di production.
XENDIT_SECRET_KEY=
# Rahasia. Token verifikasi header `x-callback-token` webhook (dibandingkan constant-time).
XENDIT_CALLBACK_TOKEN=

# --- WhatsApp (ADR §4.3, H2, T-010 §3.2, T-016) -------------------------------
# [dipakai] log | sandbox | meta. Penjaga start (API):
#   - production WAJIB `meta`; `log` & `sandbox` ditolak di production.
#   - `meta` ditolak di luar production.
#   - Kosong = `log` di development/test; staging/production wajib diisi.
# `log`: tidak mengirim apa pun; kode OTP hanya di memori proses. Di development/test kode bisa
#   diambil lewat POST /api/dev/otp-terakhir { nomorHp } (endpoint tidak ada di staging/production).
# `sandbox`: Cloud API Meta, HANYA ke nomor di WA_SANDBOX_NOMOR_IZIN.
WA_MODE=log
# [dipakai, sandbox/meta] Versi Graph API yang dipin, mis. v21.0 (verifikasi di dokumentasi Meta).
WA_API_VERSI=
# [dipakai, sandbox/meta] ID nomor pengirim (WhatsApp Manager).
WA_PHONE_NUMBER_ID=
# Rahasia [dipakai, sandbox/meta]. Token System User akun bisnis badan usaha (H7).
WA_ACCESS_TOKEN=
# [dipakai, sandbox/meta] Nama template authentication OTP. Default auth_otp_v1 (T-010 WA-01).
WA_TEMPLATE_OTP=auth_otp_v1
# [dipakai, sandbox/meta] Batas waktu per panggilan ke Meta (ms), 500–10000. Default 5000.
WA_TIMEOUT_MS=5000
# [opsional] URL dasar Graph API (hanya untuk mock di non-production). Production selalu
# https://graph.facebook.com.
WA_API_URL=
# [dipakai, sandbox] Daftar izin nomor uji, dipisah koma, tiap entri `v{versi}:{hex}` =
# HMAC-SHA256(HP_HMAC_KUNCI versi itu, nomor E.164 "+62…"). Nomor asli TIDAK ditulis di env.
# Buat (di mesin tepercaya, kunci dari secret store):
#   node -e "const c=require('crypto');console.log('v1:'+c.createHmac('sha256',Buffer.from(process.env.K,'base64')).update(process.argv[1]).digest('hex'))" +62812xxxxxxx
# Versi yang tidak dikenal (bukan HP_HMAC_KUNCI_VERSI / HP_HMAC_KUNCI_LAMA) → gagal start.
WA_SANDBOX_NOMOR_IZIN=
# Menyusul (T-035 outbox & webhook): WA_WABA_ID, WA_APP_SECRET, WA_WEBHOOK_VERIFY_TOKEN, WA_KIRIM_PER_DETIK.

# --- Login OTP pembeli (T-016) -----------------------------------------------
# [dipakai] Aktif bila DATABASE_URL + ketiga kunci di bawah diisi; ketiganya kosong = /api/masuk*
# menjawab 503. Sebagian diisi / format salah / ada kunci yang sama → API gagal start.
# Semua kunci: minimal 32 byte, base64, WAJIB berbeda satu sama lain.
#   Buat: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rahasia. Kunci HMAC nomor HP (akun.hp_hmac, otp_permintaan.hp_hmac, daftar izin sandbox).
# Mengganti kunci TANPA memindahkan yang lama ke HP_HMAC_KUNCI_LAMA = akun lama tidak dikenali.
HP_HMAC_KUNCI=
# [dipakai] Versi kunci di atas (1–32767). Default 1.
HP_HMAC_KUNCI_VERSI=1
# Rahasia [opsional]. Kunci HMAC HP versi lama untuk MENCARI akun (rotasi): `v{n}:{base64}`, pisah
# koma. Akun lama di-HMAC ulang ke versi aktif saat login berikutnya.
HP_HMAC_KUNCI_LAMA=
# Rahasia. Pepper HMAC kode OTP (otp_permintaan.kode_hmac). Mengganti kunci = OTP yang sedang
# berjalan tidak berlaku (umur OTP hanya menit).
OTP_KODE_KUNCI=
# [dipakai] Versi pepper di atas. Default 1.
OTP_KODE_KUNCI_VERSI=1
# Rahasia. Kunci HMAC token CSRF & ip_hmac pembeli. Mengganti kunci = token CSRF lama tidak berlaku.
SESI_PEMBELI_KUNCI=
# [dipakai] Angka teknis DEFAULT SEMENTARA (keputusan terbuka W-01), bisa diubah tanpa ubah kode:
# umur kode (menit, 2–10)
OTP_KEDALUWARSA_MENIT=5
# percobaan per kode (1–10); habis → kode hangus
OTP_MAKS_PERCOBAAN=5
# jeda minimal kirim ulang ke nomor yang sama (detik, 30–600)
OTP_JEDA_KIRIM_ULANG_DETIK=60
# kirim per nomor per hari WIB (1–50)
OTP_MAKS_KIRIM_PER_HARI=8
# percobaan salah per nomor per hari WIB, tidak di-reset kirim ulang (1–100)
OTP_MAKS_GAGAL_PER_HARI=15
# kirim per IP (IPv6: per /64) per jam; longgar karena CGNAT operator seluler
OTP_MAKS_KIRIM_PER_IP_PER_JAM=30
# verifikasi per IP per menit
OTP_MAKS_VERIFIKASI_PER_IP_PER_MENIT=30
# anggaran global semua OTP per jam / per hari WIB (anti pumping biaya WA), 0 = tanpa batas
OTP_ANGGARAN_JAM=600
OTP_ANGGARAN_HARI=5000
# [dipakai] Umur absolut sesi pembeli (hari, 1–180) & batas idle (hari). Default 30 & 14.
SESI_PEMBELI_HARI=30
SESI_PEMBELI_IDLE_HARI=14
# Catatan: batas laju per IP memakai IP klien dari TRUST_PROXY (di atas); XFF dari alamat lain
# diabaikan. APP_BASE_URL dipakai sebagai satu-satunya Origin yang boleh memanggil /api/masuk.

# --- Log ---------------------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
